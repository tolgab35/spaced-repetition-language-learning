<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.srll.javafx.controller.RegisterController"
      alignment="CENTER" spacing="16" style="-fx-padding: 40;">

    <Label text="SRLL" style="-fx-font-size: 32; -fx-font-weight: bold;" />
    <Label text="Create Account" style="-fx-font-size: 16; -fx-text-fill: #7f8c8d;" />

    <TextField fx:id="usernameField" promptText="Username" maxWidth="300" prefWidth="300" />
    <TextField fx:id="emailField"    promptText="Email"    maxWidth="300" prefWidth="300" />
    <PasswordField fx:id="passwordField" promptText="Password (6+ characters)"
                  maxWidth="300" prefWidth="300" />

    <Button fx:id="registerButton" text="Create Account" defaultButton="true"
            maxWidth="300" prefWidth="300" onAction="#handleRegister" />

    <ProgressIndicator fx:id="loadingIndicator" visible="false" maxWidth="32" maxHeight="32" />

    <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="300"
           style="-fx-text-fill: #e74c3c;" visible="false" />

    <Hyperlink text="Already have an account? Log In" onAction="#handleLoginLink" />

</VBox>
