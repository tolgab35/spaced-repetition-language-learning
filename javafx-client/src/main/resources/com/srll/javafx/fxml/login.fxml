<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.srll.javafx.controller.LoginController"
      alignment="CENTER" spacing="16" style="-fx-padding: 40;">

    <Label text="SRLL" style="-fx-font-size: 32; -fx-font-weight: bold;" />

    <TextField fx:id="usernameField" promptText="Username" maxWidth="300" prefWidth="300" />
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300" prefWidth="300" />

    <Button fx:id="loginButton" text="Log In" defaultButton="true"
            maxWidth="300" prefWidth="300" onAction="#handleLogin" />

    <ProgressIndicator fx:id="loadingIndicator" visible="false" maxWidth="32" maxHeight="32" />

    <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="300"
           style="-fx-text-fill: #e74c3c;" visible="false" />

    <Hyperlink text="Don't have an account? Register" onAction="#handleRegister" />

</VBox>
