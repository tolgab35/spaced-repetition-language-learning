<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.ReviewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 16; -fx-background-color: #2c3e50;">
            <Button text="✕ End Session" onAction="#handleEndSession"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            <Label fx:id="progressLabel" text="Card 0 / 0"
                   style="-fx-text-fill: white; -fx-font-size: 14;" />
            <ProgressBar fx:id="sessionProgress" progress="0"
                         HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="cardContainer"
                   style="-fx-padding: 40; -fx-background-color: #f5f6fa;">

            <StackPane fx:id="frontFace"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);
                              -fx-min-width: 480; -fx-min-height: 280;">
                <Label fx:id="frontLabel" text="" wrapText="true" maxWidth="420"
                       style="-fx-font-size: 22; -fx-text-alignment: center;" />
            </StackPane>

            <StackPane fx:id="backFace" visible="false" managed="false"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);
                              -fx-min-width: 480; -fx-min-height: 280;">
                <Label fx:id="backLabel" text="" wrapText="true" maxWidth="420"
                       style="-fx-font-size: 22; -fx-text-alignment: center;" />
            </StackPane>

        </StackPane>
    </center>

    <bottom>
        <VBox fx:id="buttonArea" alignment="CENTER" spacing="12"
              style="-fx-padding: 24; -fx-background-color: white;
                     -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <Button fx:id="showAnswerBtn" text="Show Answer"
                    onAction="#handleShowAnswer"
                    maxWidth="Infinity" prefHeight="48"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16;" />

            <HBox fx:id="ratingBox" visible="false" managed="false"
                  alignment="CENTER" spacing="12">
                <Button text="Again (0)"  onAction="#handleAgain" prefWidth="120" prefHeight="60"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13;" />
                <Button text="Hard (3)"   onAction="#handleHard"  prefWidth="120" prefHeight="60"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 13;" />
                <Button text="Good (4)"   onAction="#handleGood"  prefWidth="120" prefHeight="60"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13;" />
                <Button text="Easy (5)"   onAction="#handleEasy"  prefWidth="120" prefHeight="60"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 13;" />
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
