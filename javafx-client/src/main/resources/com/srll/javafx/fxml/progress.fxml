<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.ProgressController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 16; -fx-background-color: #2c3e50;">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: white; -fx-text-fill: #2c3e50;" />
            <Label text="My Progress"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f6fa; -fx-background: #f5f6fa;">
            <content>
                <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f5f6fa;">

                    <!-- LevelPanel -->
                    <VBox fx:id="levelPanel" spacing="8" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);
                                 -fx-padding: 24;">
                        <Label fx:id="levelLabel" text="Level —"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <ProgressBar fx:id="xpBar" progress="0"
                                     maxWidth="Infinity" prefHeight="20"
                                     style="-fx-accent: #3498db;" />
                        <Label fx:id="xpLabel" text="— / 100 XP to next level"
                               style="-fx-text-fill: #7f8c8d;" />
                    </VBox>

                    <!-- StatsPanel -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);
                                 -fx-padding: 24;">
                        <Label text="Statistics"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <GridPane fx:id="statsGrid" hgap="16" vgap="10" />
                    </VBox>

                    <!-- BadgePanel -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);
                                 -fx-padding: 24;">
                        <Label fx:id="badgeTitle" text="Badges"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <FlowPane fx:id="badgePane" hgap="12" vgap="12" />
                    </VBox>

                    <!-- LeaderboardPanel -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);
                                 -fx-padding: 24;">
                        <Label text="Top 10 Leaderboard"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <TableView fx:id="leaderboardTable"
                                   prefHeight="280">
                            <columns>
                                <TableColumn fx:id="rankColumn" text="#"    prefWidth="50"  sortable="false" />
                                <TableColumn fx:id="userColumn" text="User" prefWidth="200" sortable="false" />
                                <TableColumn fx:id="xpColumn"   text="XP"   prefWidth="100" sortable="false" />
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
