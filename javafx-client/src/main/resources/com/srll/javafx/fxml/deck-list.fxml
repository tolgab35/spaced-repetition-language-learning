<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.DeckListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 16; -fx-background-color: #3498db;">
            <Label text="My Decks"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Progress" onAction="#handleProgress"
                    style="-fx-background-color: white; -fx-text-fill: #3498db;" />
            <Button text="Log Out" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="deckListContainer" spacing="12"
                      style="-fx-padding: 24; -fx-background-color: #f5f6fa;" />
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding: 12 24; -fx-background-color: white;
                     -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Button text="+ New Deck" onAction="#handleNewDeck"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-font-size: 14; -fx-padding: 8 16;" />
        </HBox>
    </bottom>

</BorderPane>
