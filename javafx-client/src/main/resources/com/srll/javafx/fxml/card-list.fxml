<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.CardListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header">
            <Button text="← Back" onAction="#handleBack" styleClass="header-btn-light" />
            <Label fx:id="deckNameLabel" text="" styleClass="header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Add Card" onAction="#handleAddCard"
                    styleClass="header-btn-light" style="-fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
            <VBox fx:id="cardContainer" styleClass="deck-list-bg" spacing="12" />
        </ScrollPane>
    </center>

</BorderPane>
