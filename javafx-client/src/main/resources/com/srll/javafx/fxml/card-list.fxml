<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.CardListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 16; -fx-background-color: #3498db;">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: white; -fx-text-fill: #3498db;" />
            <Label fx:id="deckNameLabel" text=""
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Add Card" onAction="#handleAddCard"
                    style="-fx-background-color: white; -fx-text-fill: #3498db; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="cardTable"
                   style="-fx-padding: 16;"
                   columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
            <columns>
                <TableColumn fx:id="frontColumn"      text="Front"       prefWidth="200" />
                <TableColumn fx:id="backColumn"       text="Back"        prefWidth="200" />
                <TableColumn fx:id="intervalColumn"   text="Interval"    prefWidth="100" />
                <TableColumn fx:id="nextReviewColumn" text="Next Review" prefWidth="130" />
                <TableColumn fx:id="actionsColumn"    text="Actions"     prefWidth="150" sortable="false" />
            </columns>
        </TableView>
    </center>

</BorderPane>
