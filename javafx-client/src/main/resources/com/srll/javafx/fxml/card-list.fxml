<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srll.javafx.controller.CardListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header">
            <Button text="← Back" onAction="#handleBack" styleClass="header-btn-light" />
            <Label fx:id="deckNameLabel" text="" styleClass="header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Add Card" onAction="#handleAddCard"
                    styleClass="header-btn-light" style="-fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-bg" style="-fx-padding: 16;">
            <TableView fx:id="cardTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="frontColumn"      text="Front"       prefWidth="200" />
                    <TableColumn fx:id="backColumn"       text="Back"        prefWidth="200" />
                    <TableColumn fx:id="intervalColumn"   text="Interval"    prefWidth="100" />
                    <TableColumn fx:id="nextReviewColumn" text="Next Review" prefWidth="130" />
                    <TableColumn fx:id="actionsColumn"    text="Actions"     prefWidth="150" sortable="false" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
